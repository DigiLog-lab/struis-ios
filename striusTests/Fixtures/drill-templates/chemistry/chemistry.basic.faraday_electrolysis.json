{
  "format": 1,
  "skill_id": "chemistry.basic.faraday_electrolysis",
  "title": "電気分解の量的関係(ファラデーの法則)",
  "subject": "chemistry",
  "variables": [
    {
      "name": "F",
      "kind": "constant",
      "value": 96500.0,
      "unit": "C/mol",
      "sig": 3
    },
    {
      "name": "cur",
      "kind": "decimal",
      "min": 0.5,
      "max": 5.0,
      "step": 0.25,
      "unit": "A",
      "sig": 3
    },
    {
      "name": "t",
      "kind": "choice",
      "options": [
        965,
        1930,
        3860,
        5790,
        9650
      ],
      "unit": "s",
      "sig": 3
    },
    {
      "name": "m",
      "kind": "choice",
      "options": [
        {
          "name": "銅",
          "ion": "\\mathrm{Cu^{2+}}",
          "M": 63.5,
          "z": 2
        },
        {
          "name": "銀",
          "ion": "\\mathrm{Ag^{+}}",
          "M": 108,
          "z": 1
        },
        {
          "name": "亜鉛",
          "ion": "\\mathrm{Zn^{2+}}",
          "M": 65.4,
          "z": 2
        },
        {
          "name": "ニッケル",
          "ion": "\\mathrm{Ni^{2+}}",
          "M": 58.7,
          "z": 2
        }
      ]
    }
  ],
  "lets": [
    {
      "name": "ne",
      "expr": "cur*t/F",
      "unit": "mol",
      "sig": 2
    },
    {
      "name": "mass",
      "expr": "cur*t/F/m.z*q(m.M,'g/mol')",
      "unit": "g",
      "sig": 2
    }
  ],
  "prompt": "${m.ion}$ をふくむ水溶液を、${cur|q}$ の電流で ${t|q}$ 間電気分解した。流れた電子の物質量と、陰極に析出する{m.name}の質量を求めなさい。ファラデー定数を ${F|q}$、{m.name}のモル質量を ${m.M|dec}\\,\\mathrm{g/mol}$ とする。",
  "answer": "電子 ${ne|q}$、{m.name} ${mass|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(ne*F, cur*t)",
        "approx(value(mass,'g')*m.z, value(ne,'mol')*m.M)"
      ]
    }
  ]
}
