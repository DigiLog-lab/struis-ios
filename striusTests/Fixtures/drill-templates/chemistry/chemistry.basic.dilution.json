{
  "format": 1,
  "skill_id": "chemistry.basic.dilution",
  "title": "水溶液の希釈",
  "subject": "chemistry",
  "variables": [
    {
      "name": "c1",
      "kind": "decimal",
      "min": 1.0,
      "max": 12.0,
      "step": 0.5,
      "unit": "mol/L",
      "sig": 2
    },
    {
      "name": "c2",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "mol/L",
      "sig": 2
    },
    {
      "name": "v2",
      "kind": "choice",
      "options": [
        100,
        250,
        500,
        1000
      ],
      "unit": "mL",
      "sig": 3
    }
  ],
  "lets": [
    {
      "name": "v1",
      "expr": "c2*v2/c1",
      "unit": "mL",
      "sig": 2
    }
  ],
  "constraints": [
    "c2 < c1"
  ],
  "prompt": "${c1|q}$ の塩酸を水でうすめて、${c2|q}$ の塩酸を ${v2|q}$ つくりたい。もとの塩酸は何 mL 必要か。",
  "answer": "${v1|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(c1*v1, c2*v2)"
      ]
    }
  ]
}
