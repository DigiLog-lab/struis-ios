          "alpha": 0.001,
          "ph": 4
        },
        {
          "c": 1.0,
          "alpha": 0.001,
          "ph": 3
        },
        {
          "c": 0.01,
          "alpha": 0.1,
          "ph": 3
        },
        {
          "c": 0.001,
          "alpha": 0.1,
          "ph": 4
        },
        {
          "c": 0.1,
          "alpha": 0.1,
          "ph": 2
        },
        {
          "c": 1.0,
          "alpha": 0.01,
          "ph": 2
        },
        {
          "c": 0.001,
          "alpha": 0.01,
          "ph": 5
        },
        {
          "c": 0.01,
          "alpha": 0.001,
          "ph": 5
        }
      ]
    },
    {
      "name": "acid",
      "kind": "choice",
      "options": [
        {
          "name": "酢酸"
