  ],
  "lets": [
    {
      "name": "h",
      "expr": "m.c*m.alpha"
    }
  ],
  "prompt": "濃度 ${m.c|sig:2}\\,\\mathrm{mol/L}$ の{acid.name}の水溶液がある。電離度が ${m.alpha|sig:2}$ のとき、水素イオン濃度と pH を求めなさい。",
  "answer": "$[\\mathrm{H^{+}}] = {h|sig:2}\\,\\mathrm{mol/L}$、$\\mathrm{pH} = {m.ph}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(10^(-m.ph), h)"
      ]
    }
  ]
}
