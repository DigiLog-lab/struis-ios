{
  "format": 1,
  "skill_id": "chemistry.basic.solution_preparation",
  "title": "決まったモル濃度の水溶液をつくるのに必要な溶質の質量",
  "subject": "chemistry",
  "variables": [
    {
      "name": "s",
      "kind": "choice",
      "options": [
        {
          "tex": "\\mathrm{NaCl}",
          "name": "塩化ナトリウム",
          "M": 58.5
        },
        {
          "tex": "\\mathrm{NaOH}",
          "name": "水酸化ナトリウム",
          "M": 40
        },
        {
          "tex": "\\mathrm{C_6H_{12}O_6}",
          "name": "グルコース",
          "M": 180
        },
        {
          "tex": "\\mathrm{KNO_3}",
          "name": "硝酸カリウム",
          "M": 101
        },
        {
          "tex": "\\mathrm{CuSO_4}",
          "name": "硫酸銅(II)",
          "M": 160
        },
        {
          "tex": "\\mathrm{Na_2CO_3}",
          "name": "炭酸ナトリウム",
          "M": 106
        }
      ]
    },
    {
      "name": "c",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "mol/L",
      "sig": 2
    },
    {
      "name": "vol",
      "kind": "choice",
      "options": [
        100,
        200,
        250,
        500,
        1000
      ],
      "unit": "mL",
      "sig": 3
    }
  ],
  "lets": [
    {
      "name": "M",
      "expr": "q(s.M,'g/mol')",
      "unit": "g/mol"
    },
    {
      "name": "m",
      "expr": "c*vol*M",
      "unit": "g",
      "sig": 2
    }
  ],
  "prompt": "${c|q}$ の{s.name}水溶液を ${vol|q}$ つくるのに必要な{s.name} ${s.tex}$(モル質量 ${s.M|dec}\\,\\mathrm{g/mol}$)の質量を求めなさい。",
  "answer": "${m|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(m/M/vol, c)"
      ]
    }
  ]
}
