{
  "format": 1,
  "skill_id": "chemistry.univ.first_order_remaining",
  "title": "1 次反応の濃度の時間変化",
  "subject": "chemistry",
  "variables": [
    {
      "name": "c0",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1
    },
    {
      "name": "half",
      "kind": "integer",
      "min": 10,
      "max": 120,
      "step": 10
    },
    {
      "name": "n",
      "kind": "integer",
      "min": 1,
      "max": 5
    }
  ],
  "lets": [
    {
      "name": "t",
      "expr": "half*n"
    },
    {
      "name": "c",
      "expr": "c0/2^n"
    }
  ],
  "prompt": "半減期が ${half}\\,\\mathrm{s}$ の 1 次反応で、はじめの濃度が ${c0|dec:2}\\,\\mathrm{mol/L}$ であった。${t}\\,\\mathrm{s}$ 後の濃度を求めなさい。",
  "answer": "${c|sig:2}\\,\\mathrm{mol/L}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(c, c0*exp(-ln(2)/half*t))"
      ]
    }
  ]
}
