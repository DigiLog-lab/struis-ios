{
  "format": 1,
  "skill_id": "chemistry.theory.lead_storage_battery",
  "title": "鉛蓄電池の放電による電極の質量変化",
  "subject": "chemistry",
  "variables": [
    {
      "name": "ne",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "mol",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "neg",
      "expr": "value(ne,'mol')/2*96"
    },
    {
      "name": "pos",
      "expr": "value(ne,'mol')/2*64"
    }
  ],
  "prompt": "鉛蓄電池を放電して、電子 ${ne|q}$ が流れた。負極と正極の質量は、それぞれ何 g 増加するか。原子量は O = 16、S = 32 とする。",
  "answer": "負極 ${neg|sig:2}\\,\\mathrm{g}$、正極 ${pos|sig:2}\\,\\mathrm{g}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(neg/96*2, value(ne,'mol'))",
        "approx(pos/64*2, value(ne,'mol'))"
      ]
    }
  ]
}
