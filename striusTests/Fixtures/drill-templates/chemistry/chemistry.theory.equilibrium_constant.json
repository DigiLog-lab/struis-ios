{
  "format": 1,
  "skill_id": "chemistry.theory.equilibrium_constant",
  "title": "平衡定数を求める",
  "subject": "chemistry",
  "variables": [
    {
      "name": "h2",
      "kind": "decimal",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1
    },
    {
      "name": "i2",
      "kind": "decimal",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1
    },
    {
      "name": "hi",
      "kind": "decimal",
      "min": 0.5,
      "max": 4.0,
      "step": 0.5
    }
  ],
  "lets": [
    {
      "name": "kc",
      "expr": "hi^2/(h2*i2)"
    }
  ],
  "prompt": "ある温度で $\\mathrm{H_2} + \\mathrm{I_2}$ ⇄ $2\\mathrm{HI}$ の反応が平衡状態にあり、各物質の濃度は $[\\mathrm{H_2}] = {h2|dec:2}\\,\\mathrm{mol/L}$、$[\\mathrm{I_2}] = {i2|dec:2}\\,\\mathrm{mol/L}$、$[\\mathrm{HI}] = {hi|dec:2}\\,\\mathrm{mol/L}$ であった。この温度での平衡定数 $K$ を求めなさい。",
  "answer": "$K = {kc|sig:2}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(kc*h2*i2, hi*hi)"
      ]
    }
  ]
}
