{
  "format": 1,
  "skill_id": "physics.mech.atwood",
  "title": "定滑車にかけた 2 物体の運動",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "m1",
      "kind": "decimal",
      "min": 1.0,
      "max": 6.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "m2",
      "kind": "decimal",
      "min": 1.0,
      "max": 6.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "a",
      "expr": "(m1 - m2)*g/(m1 + m2)",
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "tension",
      "expr": "2*m1*m2*g/(m1 + m2)",
      "unit": "N",
      "sig": 2
    }
  ],
  "constraints": [
    "m1 > m2"
  ],
  "prompt": "軽い定滑車に軽い糸をかけ、両端に質量 ${m1|q}$ の物体 A と質量 ${m2|q}$ の物体 B をつるして静かに放した。物体の加速度の大きさと、糸の張力の大きさを求めなさい。重力加速度の大きさを ${g|q}$ とする。",
  "answer": "加速度 ${a|q}$、張力 ${tension|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(m1*a, m1*g - tension)",
        "approx(m2*a, tension - m2*g)"
      ]
    }
  ]
}
