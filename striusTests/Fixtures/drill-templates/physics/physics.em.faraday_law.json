{
  "format": 1,
  "skill_id": "physics.em.faraday_law",
  "title": "ファラデーの電磁誘導の法則",
  "subject": "physics",
  "variables": [
    {
      "name": "n",
      "kind": "integer",
      "min": 50,
      "max": 500,
      "step": 50
    },
    {
      "name": "dphi",
      "kind": "decimal",
      "min": 1.0,
      "max": 9.0,
      "step": 1.0
    },
    {
      "name": "dt",
      "kind": "decimal",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1,
      "unit": "s",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "flux",
      "expr": "q(dphi*0.001,'Wb')",
      "unit": "Wb",
      "sig": 2
    },
    {
      "name": "v",
      "expr": "n*flux/dt",
      "unit": "V",
      "sig": 2
    }
  ],
  "prompt": "${n}$ 回巻きのコイルを貫く磁束が、${dt|q}$ の間に ${flux|q}$ だけ一様に変化した。コイルに生じる誘導起電力の大きさを求めなさい。",
  "answer": "${v|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(value(v,'V')*value(dt,'s'), n*dphi*0.001)"
      ]
    }
  ]
}
