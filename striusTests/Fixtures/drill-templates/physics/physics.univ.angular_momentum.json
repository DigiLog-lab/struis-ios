{
  "format": 1,
  "skill_id": "physics.univ.angular_momentum",
  "title": "角運動量(L = Iω)と角運動量保存",
  "subject": "physics",
  "variables": [
    {
      "name": "i1",
      "kind": "decimal",
      "min": 1.0,
      "max": 6.0,
      "step": 0.5,
      "unit": "kg*m^2",
      "sig": 2
    },
    {
      "name": "w1",
      "kind": "decimal",
      "min": 2.0,
      "max": 12.0,
      "step": 1.0,
      "unit": "1/s",
      "sig": 2
    },
    {
      "name": "i2",
      "kind": "decimal",
      "min": 0.5,
      "max": 5.0,
      "step": 0.5,
      "unit": "kg*m^2",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "ang",
      "expr": "i1*w1",
      "unit": "kg*m^2/s",
      "sig": 2
    },
    {
      "name": "w2",
      "expr": "i1*w1/i2",
      "unit": "1/s",
      "sig": 2
    }
  ],
  "constraints": [
    "i1 != i2"
  ],
  "prompt": "慣性モーメント ${i1|q}$ の物体が角速度 ${w1|sig:2}\\,\\mathrm{rad/s}$ で回転している。角運動量の大きさを求めなさい。また、外力のモーメントがはたらかないまま慣性モーメントが ${i2|q}$ に変わったときの角速度を求めなさい。",
  "answer": "角運動量 ${ang|q}$、角速度 ${w2|sig:2}\\,\\mathrm{rad/s}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(i2*w2, ang)"
      ]
    }
  ]
}
