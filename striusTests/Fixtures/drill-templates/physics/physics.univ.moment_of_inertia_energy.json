{
  "format": 1,
  "skill_id": "physics.univ.moment_of_inertia_energy",
  "title": "回転の運動エネルギー(½Iω²)",
  "subject": "physics",
  "variables": [
    {
      "name": "body",
      "kind": "choice",
      "options": [
        {
          "name": "一様な円板(中心軸のまわり)",
          "num": 1,
          "den": 2
        },
        {
          "name": "一様な球(直径のまわり)",
          "num": 2,
          "den": 5
        },
        {
          "name": "薄い円輪(中心軸のまわり)",
          "num": 1,
          "den": 1
        }
      ]
    },
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.5,
      "max": 5.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "r",
      "kind": "decimal",
      "min": 0.1,
      "max": 0.5,
      "step": 0.1,
      "unit": "m",
      "sig": 2
    },
    {
      "name": "omega",
      "kind": "decimal",
      "min": 2.0,
      "max": 20.0,
      "step": 2.0,
      "unit": "1/s",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "inertia",
      "expr": "body.num/body.den*m*r^2",
      "unit": "kg*m^2",
      "sig": 2
    },
    {
      "name": "energy",
      "expr": "inertia*omega^2/2",
      "unit": "J",
      "sig": 2
    }
  ],
  "prompt": "質量 ${m|q}$、半径 ${r|q}$ の{body.name}が、角速度 ${omega|sig:2}\\,\\mathrm{rad/s}$ で回転している。慣性モーメントと回転の運動エネルギーを求めなさい。",
  "answer": "慣性モーメント ${inertia|q}$、運動エネルギー ${energy|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(2*energy/omega^2, inertia)",
        "approx(inertia*body.den, body.num*m*r^2)"
      ]
    }
  ]
}
