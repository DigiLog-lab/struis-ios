{
  "format": 1,
  "skill_id": "physics.unit.energy_conversion",
  "title": "エネルギーの単位換算(kWh・J)",
  "subject": "physics",
  "variables": [
    {
      "name": "e0",
      "kind": "decimal",
      "min": 0.5,
      "max": 20.0,
      "step": 0.5
    }
  ],
  "lets": [
    {
      "name": "joule",
      "expr": "e0*3600000"
    }
  ],
  "prompt": "${e0|dec:1}\\,\\mathrm{kWh}$ は何 J か。",
  "answer": "${joule|sig:2}\\,\\mathrm{J}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "value(q(e0*1000,'W')*q(1,'h'),'J') == joule"
      ]
    }
  ]
}
