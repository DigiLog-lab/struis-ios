{
  "format": 1,
  "skill_id": "physics.mech.potential_energy_spring",
  "title": "弾性力による位置エネルギー(½kx²)",
  "subject": "physics",
  "variables": [
    {
      "name": "k",
      "kind": "integer",
      "min": 20,
      "max": 400,
      "step": 20,
      "unit": "N/m",
      "sig": 2
    },
    {
      "name": "x",
      "kind": "decimal",
      "min": 0.05,
      "max": 0.5,
      "step": 0.05,
      "unit": "m",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "u",
      "expr": "k*x^2/2",
      "unit": "J",
      "sig": 2
    },
    {
      "name": "kk",
      "expr": "value(k,'N/m')"
    },
    {
      "name": "uu",
      "expr": "value(u,'J')"
    }
  ],
  "prompt": "ばね定数 ${k|q}$ のばねが自然の長さから ${x|q}$ だけ伸びているとき、弾性力による位置エネルギーを求めなさい。",
  "answer": "${u|q}$",
  "checks": [
    {
      "kind": "definite_integral",
      "integrand": "{kk}s",
      "variable": "s",
      "from": "0",
      "to": "value(x,'m')",
      "answer": "{uu|dec}"
    }
  ]
}
