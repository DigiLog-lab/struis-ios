{
  "format": 1,
  "skill_id": "physics.mech.kepler_third",
  "title": "ケプラーの第 3 法則",
  "subject": "physics",
  "variables": [
    {
      "name": "ratio",
      "kind": "choice",
      "options": [
        4,
        9,
        16,
        25,
        36,
        49,
        64,
        100
      ]
    },
    {
      "name": "t1",
      "kind": "decimal",
      "min": 1.0,
      "max": 12.0,
      "step": 0.5
    }
  ],
  "lets": [
    {
      "name": "t2",
      "expr": "t1*ratio^(3/2)"
    }
  ],
  "prompt": "ある恒星のまわりを、惑星 A が公転周期 ${t1|dec:1}$ 年、軌道の長半径 $a$ の楕円軌道を描いて回っている。同じ恒星のまわりを回る惑星 B の軌道の長半径が ${ratio}a$ のとき、B の公転周期は何年か。",
  "answer": "${t2|dec:1}$ 年",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(t2^2/ratio^3, t1^2)"
      ]
    }
  ]
}
