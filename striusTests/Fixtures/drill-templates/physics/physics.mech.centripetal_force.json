{
  "format": 1,
  "skill_id": "physics.mech.centripetal_force",
  "title": "向心力(F = mv²/r)",
  "subject": "physics",
  "variables": [
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "r",
      "kind": "decimal",
      "min": 0.2,
      "max": 2.0,
      "step": 0.1,
      "unit": "m",
      "sig": 2
    },
    {
      "name": "v",
      "kind": "decimal",
      "min": 1.0,
      "max": 10.0,
      "step": 0.5,
      "unit": "m/s",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "f",
      "expr": "m*v^2/r",
      "unit": "N",
      "sig": 2
    }
  ],
  "prompt": "質量 ${m|q}$ の物体が、半径 ${r|q}$ の円周上を速さ ${v|q}$ で等速円運動をしている。物体にはたらく向心力の大きさを求めなさい。",
  "answer": "${f|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(f*r, m*v^2)"
      ]
    }
  ]
}
