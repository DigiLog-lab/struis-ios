{
  "format": 1,
  "skill_id": "physics.em.electric_field_force",
  "title": "電場から受ける力(F = qE)",
  "subject": "physics",
  "variables": [
    {
      "name": "charge",
      "kind": "decimal",
      "min": 1.0,
      "max": 9.0,
      "step": 0.5,
      "unit": "uC",
      "sig": 2
    },
    {
      "name": "field",
      "kind": "decimal",
      "min": 1.0,
      "max": 9.0,
      "step": 0.5
    },
    {
      "name": "ex",
      "kind": "choice",
      "options": [
        3,
        4,
        5
      ]
    }
  ],
  "lets": [
    {
      "name": "e0",
      "expr": "q(field*10^ex,'N/C')",
      "unit": "N/C",
      "sig": 2
    },
    {
      "name": "f",
      "expr": "charge*e0",
      "unit": "N",
      "sig": 2
    }
  ],
  "prompt": "強さ ${e0|q}$ の電場の中に置かれた ${charge|q}$ の点電荷が受ける力の大きさを求めなさい。",
  "answer": "${f|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(f/charge, e0)"
      ]
    }
  ]
}
