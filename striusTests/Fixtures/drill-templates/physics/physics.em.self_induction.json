{
  "format": 1,
  "skill_id": "physics.em.self_induction",
  "title": "自己誘導(V = L ΔI/Δt)",
  "subject": "physics",
  "variables": [
    {
      "name": "ind",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "H",
      "sig": 2
    },
    {
      "name": "di",
      "kind": "decimal",
      "min": 0.5,
      "max": 5.0,
      "step": 0.5,
      "unit": "A",
      "sig": 2
    },
    {
      "name": "dt",
      "kind": "decimal",
      "min": 0.01,
      "max": 0.1,
      "step": 0.01,
      "unit": "s",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "v",
      "expr": "ind*di/dt",
      "unit": "V",
      "sig": 2
    },
    {
      "name": "u",
      "expr": "ind*di^2/2",
      "unit": "J",
      "sig": 2
    }
  ],
  "prompt": "自己インダクタンス ${ind|q}$ のコイルを流れる電流が、${dt|q}$ の間に 0 から ${di|q}$ まで一様に増加した。コイルに生じる誘導起電力の大きさと、電流が ${di|q}$ のときにコイルにたくわえられているエネルギーを求めなさい。",
  "answer": "誘導起電力 ${v|q}$、エネルギー ${u|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(v*dt, ind*di)",
        "approx(2*u, ind*di*di)"
      ]
    }
  ]
}
