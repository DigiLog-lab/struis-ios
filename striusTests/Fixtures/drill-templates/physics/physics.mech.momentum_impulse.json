{
  "format": 1,
  "skill_id": "physics.mech.momentum_impulse",
  "title": "運動量と力積",
  "subject": "physics",
  "variables": [
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "v1",
      "kind": "decimal",
      "min": 2.0,
      "max": 30.0,
      "step": 2.0,
      "unit": "m/s",
      "sig": 2
    },
    {
      "name": "v2",
      "kind": "decimal",
      "min": 2.0,
      "max": 30.0,
      "step": 2.0,
      "unit": "m/s",
      "sig": 2
    },
    {
      "name": "dt",
      "kind": "decimal",
      "min": 0.01,
      "max": 0.2,
      "step": 0.01,
      "unit": "s",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "imp",
      "expr": "m*(v1 + v2)",
      "unit": "N*s",
      "sig": 2
    },
    {
      "name": "f",
      "expr": "m*(v1 + v2)/dt",
      "unit": "N",
      "sig": 2
    }
  ],
  "prompt": "質量 ${m|q}$ のボールが速さ ${v1|q}$ で壁に垂直に当たり、逆向きに速さ ${v2|q}$ ではね返った。ボールが壁から受けた力積の大きさと、接触していた時間が ${dt|q}$ のときの平均の力の大きさを求めなさい。",
  "answer": "力積 ${imp|q}$、平均の力 ${f|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(f*dt, imp)",
        "approx(imp, m*v2 - m*(-v1))"
      ]
    }
  ]
}
