{
  "format": 1,
  "skill_id": "physics.em.motional_emf",
  "title": "磁場を横切る導体棒の誘導起電力(V = vBL)",
  "subject": "physics",
  "variables": [
    {
      "name": "v",
      "kind": "decimal",
      "min": 0.5,
      "max": 10.0,
      "step": 0.5,
      "unit": "m/s",
      "sig": 2
    },
    {
      "name": "b",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "T",
      "sig": 2
    },
    {
      "name": "len",
      "kind": "decimal",
      "min": 0.1,
      "max": 1.0,
      "step": 0.1,
      "unit": "m",
      "sig": 2
    },
    {
      "name": "r",
      "kind": "decimal",
      "min": 1.0,
      "max": 10.0,
      "step": 1.0,
      "unit": "ohm",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "emf",
      "expr": "v*b*len",
      "unit": "V",
      "sig": 2
    },
    {
      "name": "cur",
      "expr": "v*b*len/r",
      "unit": "A",
      "sig": 2
    }
  ],
  "prompt": "磁束密度 ${b|q}$ の一様な磁場に垂直な面内で、長さ ${len|q}$ の導体棒を、棒と磁場の両方に垂直な向きに速さ ${v|q}$ で動かした。導体棒に生じる誘導起電力の大きさを求めなさい。また、棒を抵抗値 ${r|q}$ の抵抗につないだときに流れる電流の大きさを求めなさい。",
  "answer": "誘導起電力 ${emf|q}$、電流 ${cur|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(cur*r, emf)",
        "approx(emf/(b*len), v)"
      ]
    }
  ]
}
