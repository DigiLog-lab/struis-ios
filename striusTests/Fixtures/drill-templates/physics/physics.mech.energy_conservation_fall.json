{
  "format": 1,
  "skill_id": "physics.mech.energy_conservation_fall",
  "title": "力学的エネルギーの保存(落下する物体の速さ)",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "h",
      "kind": "decimal",
      "min": 0.5,
      "max": 20.0,
      "step": 0.5,
      "unit": "m",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "v",
      "expr": "sqrt(2*g*h)",
      "unit": "m/s",
      "sig": 2
    }
  ],
  "constraints": [
    "value(h,'m') == sig(value(h,'m'), 2)"
  ],
  "prompt": "なめらかな斜面上の、水平面からの高さが ${h|q}$ の点から、小球を静かに放した。小球が水平面に達したときの速さを求めなさい。重力加速度の大きさを ${g|q}$ とする。",
  "answer": "${v|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(v^2/2, g*h)"
      ]
    }
  ]
}
