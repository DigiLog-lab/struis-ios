{
  "format": 1,
  "skill_id": "physics.mech.pressure",
  "title": "圧力(p = F/S)",
  "subject": "physics",
  "variables": [
    {
      "name": "f",
      "kind": "integer",
      "min": 10,
      "max": 500,
      "step": 10,
      "unit": "N",
      "sig": 2
    },
    {
      "name": "s",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "m^2",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "p",
      "expr": "f/s",
      "unit": "Pa",
      "sig": 2
    }
  ],
  "prompt": "面積 ${s|q}$ の面を、大きさ ${f|q}$ の力で垂直に押している。この面が受ける圧力を求めなさい。",
  "answer": "${p|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(p*s, f)"
      ]
    }
  ]
}
