{
  "format": 1,
  "skill_id": "physics.mech.friction_max_static",
  "title": "最大摩擦力と動摩擦力",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "m",
      "kind": "decimal",
      "min": 1.0,
      "max": 20.0,
      "step": 1.0,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "mu",
      "kind": "decimal",
      "min": 0.2,
      "max": 0.8,
      "step": 0.05
    },
    {
      "name": "mud",
      "kind": "decimal",
      "min": 0.1,
      "max": 0.6,
      "step": 0.05
    }
  ],
  "lets": [
    {
      "name": "fmax",
      "expr": "mu*m*g",
      "unit": "N",
      "sig": 2
    },
    {
      "name": "fk",
      "expr": "mud*m*g",
      "unit": "N",
      "sig": 2
    }
  ],
  "constraints": [
    "mud < mu"
  ],
  "prompt": "水平なあらい床の上に質量 ${m|q}$ の物体が置かれている。物体と床の間の静止摩擦係数は ${mu|dec:2}$、動摩擦係数は ${mud|dec:2}$ である。最大摩擦力の大きさと、物体がすべっているときの動摩擦力の大きさを求めなさい。重力加速度の大きさを ${g|q}$ とする。",
  "answer": "最大摩擦力 ${fmax|q}$、動摩擦力 ${fk|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(fmax/(m*g), mu)",
        "approx(fk/fmax, mud/mu)"
      ]
    }
  ]
}
