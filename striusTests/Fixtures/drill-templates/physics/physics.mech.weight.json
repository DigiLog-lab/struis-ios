{
  "format": 1,
  "skill_id": "physics.mech.weight",
  "title": "重力の大きさ(W = mg)",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.5,
      "max": 20.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "w",
      "expr": "m*g",
      "unit": "N",
      "sig": 2
    }
  ],
  "prompt": "質量 ${m|q}$ の物体にはたらく重力の大きさを求めなさい。重力加速度の大きさを ${g|q}$ とする。",
  "answer": "${w|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(w/g, m)"
      ]
    }
  ]
}
