{
  "format": 1,
  "skill_id": "physics.mech.spring_hanging",
  "title": "ばねにつるしたおもりのつり合い",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "k",
      "kind": "integer",
      "min": 20,
      "max": 200,
      "step": 20,
      "unit": "N/m",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "x",
      "expr": "m*g/k",
      "unit": "m",
      "sig": 2
    }
  ],
  "prompt": "ばね定数 ${k|q}$ の軽いばねの一端を天井に固定し、他端に質量 ${m|q}$ のおもりをつるして静止させた。ばねの伸びを求めなさい。重力加速度の大きさを ${g|q}$ とする。",
  "answer": "${x|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(k*x, m*g)"
      ]
    }
  ]
}
