{
  "format": 1,
  "skill_id": "physics.mech.restitution",
  "title": "反発係数(床ではね返る小球)",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "h",
      "kind": "decimal",
      "min": 0.5,
      "max": 5.0,
      "step": 0.25,
      "unit": "m",
      "sig": 2
    },
    {
      "name": "e0",
      "kind": "decimal",
      "min": 0.3,
      "max": 0.9,
      "step": 0.1
    }
  ],
  "lets": [
    {
      "name": "h2",
      "expr": "e0^2*h",
      "unit": "m",
      "sig": 2
    },
    {
      "name": "v1",
      "expr": "sqrt(2*g*h)",
      "unit": "m/s"
    },
    {
      "name": "v2",
      "expr": "sqrt(2*g*h2)",
      "unit": "m/s"
    }
  ],
  "prompt": "高さ ${h|q}$ の所から小球を自由落下させたところ、床ではね返った。小球と床の間の反発係数を ${e0|dec:2}$ として、はね返った後に達する最高点の高さを求めなさい。",
  "answer": "${h2|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(v2/v1, e0)"
      ]
    }
  ]
}
