{
  "format": 1,
  "skill_id": "physics.mech.two_blocks_string",
  "title": "糸でつながれた 2 物体の運動",
  "subject": "physics",
  "variables": [
    {
      "name": "m1",
      "kind": "decimal",
      "min": 1.0,
      "max": 6.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "m2",
      "kind": "decimal",
      "min": 1.0,
      "max": 6.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "f",
      "kind": "decimal",
      "min": 4.0,
      "max": 48.0,
      "step": 2.0,
      "unit": "N",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "a",
      "expr": "f/(m1 + m2)",
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "tension",
      "expr": "m1*f/(m1 + m2)",
      "unit": "N",
      "sig": 2
    }
  ],
  "prompt": "なめらかな水平面上で、質量 ${m1|q}$ の物体 A と質量 ${m2|q}$ の物体 B を軽い糸でつなぎ、B を水平方向に大きさ ${f|q}$ の力で引いた。加速度の大きさと、糸の張力の大きさを求めなさい。",
  "answer": "加速度 ${a|q}$、張力 ${tension|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(m1*a, tension)",
        "approx(m2*a, f - tension)"
      ]
    }
  ]
}
