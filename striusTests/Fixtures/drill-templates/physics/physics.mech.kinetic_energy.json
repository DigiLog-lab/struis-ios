{
  "format": 1,
  "skill_id": "physics.mech.kinetic_energy",
  "title": "運動エネルギー(½mv²)",
  "subject": "physics",
  "variables": [
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.5,
      "max": 20.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "v",
      "kind": "decimal",
      "min": 1.0,
      "max": 20.0,
      "step": 1.0,
      "unit": "m/s",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "k",
      "expr": "m*v^2/2",
      "unit": "J",
      "sig": 2
    }
  ],
  "constraints": [
    "value(m,'kg') == sig(value(m,'kg'), 2)"
  ],
  "prompt": "質量 ${m|q}$ の物体が速さ ${v|q}$ で運動しているときの運動エネルギーを求めなさい。",
  "answer": "${k|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(2*k/m, v^2)"
      ]
    }
  ]
}
