{
  "format": 1,
  "skill_id": "physics.mech.energy_conservation_spring",
  "title": "力学的エネルギーの保存(ばねから離れる物体の速さ)",
  "subject": "physics",
  "variables": [
    {
      "name": "k",
      "kind": "integer",
      "min": 50,
      "max": 400,
      "step": 50,
      "unit": "N/m",
      "sig": 2
    },
    {
      "name": "x",
      "kind": "decimal",
      "min": 0.1,
      "max": 0.5,
      "step": 0.05,
      "unit": "m",
      "sig": 2
    },
    {
      "name": "m",
      "kind": "decimal",
      "min": 0.5,
      "max": 4.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "v",
      "expr": "x*sqrt(k/m)",
      "unit": "m/s",
      "sig": 2
    }
  ],
  "prompt": "なめらかな水平面上で、ばね定数 ${k|q}$ のばねの一端を固定し、他端に質量 ${m|q}$ の物体を押しつけて ${x|q}$ だけ縮めてから静かに放した。物体がばねから離れるときの速さを求めなさい。",
  "answer": "${v|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(m*v^2/2, k*x^2/2)"
      ]
    }
  ]
}
