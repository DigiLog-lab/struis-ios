{
  "format": 1,
  "skill_id": "physics.mech.two_strings_tension",
  "title": "2 本の糸でつるした物体の張力",
  "subject": "physics",
  "variables": [
    {
      "name": "g",
      "kind": "constant",
      "value": 9.8,
      "unit": "m/s^2",
      "sig": 2
    },
    {
      "name": "m",
      "kind": "decimal",
      "min": 1.0,
      "max": 10.0,
      "step": 0.5,
      "unit": "kg",
      "sig": 2
    },
    {
      "name": "deg",
      "kind": "choice",
      "options": [
        30,
        45,
        60
      ]
    }
  ],
  "lets": [
    {
      "name": "tension",
      "expr": "m*g/(2*cosd(deg))",
      "unit": "N",
      "sig": 2
    }
  ],
  "prompt": "質量 ${m|q}$ のおもりを、同じ長さの 2 本の軽い糸で天井からつるした。どちらの糸も鉛直方向と ${deg}^{\\circ}$ の角をなしているとき、糸 1 本の張力の大きさを求めなさい。重力加速度の大きさを ${g|q}$ とする。",
  "answer": "${tension|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(2*tension*cosd(deg), m*g)"
      ]
    }
  ]
}
