{
  "format": 1,
  "skill_id": "physics.wave.young_double_slit",
  "title": "ヤングの実験(明線の間隔)",
  "subject": "physics",
  "variables": [
    {
      "name": "lam",
      "kind": "decimal",
      "min": 4.0,
      "max": 7.0,
      "step": 0.5
    },
    {
      "name": "d",
      "kind": "decimal",
      "min": 0.1,
      "max": 0.5,
      "step": 0.1,
      "unit": "mm",
      "sig": 2
    },
    {
      "name": "len",
      "kind": "decimal",
      "min": 1.0,
      "max": 3.0,
      "step": 0.5,
      "unit": "m",
      "sig": 2
    }
  ],
  "lets": [
    {
      "name": "wave",
      "expr": "q(lam*0.0000001,'m')",
      "unit": "m"
    },
    {
      "name": "dx",
      "expr": "len*wave/d",
      "unit": "mm",
      "sig": 2
    }
  ],
  "prompt": "間隔 ${d|q}$ の複スリットに波長 ${lam|dec:1} \\times 10^{-7}\\,\\mathrm{m}$ の単色光を当て、スリットから ${len|q}$ 離れたスクリーン上に干渉じまを作った。隣り合う明線の間隔を求めなさい。",
  "answer": "${dx|q}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "approx(value(dx,'m')*value(d,'m'), value(len,'m')*lam*0.0000001)"
      ]
    }
  ]
}
