{
  "format": 1,
  "skill_id": "math.jhs2.expression_value_two",
  "title": "式の値(2 つの文字)",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 2,
      "max": 6
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "x0",
      "kind": "integer",
      "min": -5,
      "max": 5,
      "exclude": [
        0
      ]
    },
    {
      "name": "y0",
      "kind": "integer",
      "min": -5,
      "max": 5,
      "exclude": [
        0
      ]
    }
  ],
  "lets": [
    {
      "name": "ans",
      "expr": "a*x0^2*y0 + b*x0*y0^2"
    }
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x^{2}y"
        },
        {
          "coef": "b",
          "body": "xy^{2}"
        }
      ]
    }
  ],
  "prompt": "$x = {x0}$、$y = {y0}$ のとき、次の式の値を求めなさい。",
  "math": "{f}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "value",
      "tex": "{f}",
      "at": {
        "x": "x0",
        "y": "y0"
      },
      "equals": "ans"
    }
  ]
}
