{
  "format": 1,
  "skill_id": "math.jhs1.linear_eq_parentheses",
  "title": "かっこのある一次方程式",
  "subject": "math",
  "variables": [
    {
      "name": "k",
      "kind": "integer",
      "min": 2,
      "max": 6
    },
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 4
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "c",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0
      ]
    },
    {
      "name": "x0",
      "kind": "integer",
      "min": -8,
      "max": 8
    }
  ],
  "lets": [
    {
      "name": "d",
      "expr": "k*(a*x0 + b) - c*x0"
    }
  ],
  "constraints": [
    "k*a != c",
    "abs(d) <= 40"
  ],
  "parts": [
    {
      "name": "inner",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x"
        },
        {
          "coef": "b"
        }
      ]
    },
    {
      "name": "rhs",
      "kind": "sum",
      "terms": [
        {
          "coef": "c",
          "body": "x"
        },
        {
          "coef": "d"
        }
      ]
    }
  ],
  "prompt": "次の方程式を解きなさい。",
  "math": "{k}({inner}) = {rhs}",
  "answer": "$x = {x0}$",
  "checks": [
    {
      "kind": "root",
      "left": "{k}({inner})",
      "right": "{rhs}",
      "variable": "x",
      "solutions": [
        "{x0}"
      ]
    }
  ]
}
