{
  "format": 1,
  "skill_id": "math.m3.sequence_limit_rational",
  "title": "数列の極限(分数式)",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -9,
      "max": 9
    },
    {
      "name": "c",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "d",
      "kind": "integer",
      "min": -9,
      "max": 9
    },
    {
      "name": "deg",
      "kind": "integer",
      "min": 1,
      "max": 2
    }
  ],
  "lets": [
    {
      "name": "ans",
      "expr": "a/c"
    }
  ],
  "constraints": [
    "gcd(a, c) == 1 or a == c",
    "b != 0 or d != 0"
  ],
  "parts": [
    {
      "name": "num",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "powers": [
            {
              "base": "n",
              "exp": "deg"
            }
          ]
        },
        {
          "coef": "b"
        }
      ]
    },
    {
      "name": "den",
      "kind": "sum",
      "terms": [
        {
          "coef": "c",
          "powers": [
            {
              "base": "n",
              "exp": "deg"
            }
          ]
        },
        {
          "coef": "d"
        }
      ]
    }
  ],
  "prompt": "次の極限を求めなさい。",
  "math": "\\lim_{n \\to \\infty} \\frac{{num}}{{den}}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "limit",
      "function": "\\frac{{num}}{{den}}",
      "variable": "n",
      "to": "inf",
      "answer": "{ans}"
    }
  ]
}
