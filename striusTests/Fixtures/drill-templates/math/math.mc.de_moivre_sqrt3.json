{
  "format": 1,
  "skill_id": "math.mc.de_moivre_sqrt3",
  "title": "ド・モアブルの定理(1 + √3 i など)",
  "subject": "math",
  "variables": [
    {
      "name": "sr",
      "kind": "choice",
      "options": [
        1,
        -1
      ]
    },
    {
      "name": "si",
      "kind": "choice",
      "options": [
        1,
        -1
      ]
    },
    {
      "name": "form",
      "kind": "choice",
      "options": [
        1,
        2
      ]
    },
    {
      "name": "n",
      "kind": "integer",
      "min": 3,
      "max": 8
    }
  ],
  "lets": [
    {
      "name": "z",
      "expr": "if(form == 1, sr + si*sqrt(3)*i, sr*sqrt(3) + si*i)"
    },
    {
      "name": "w",
      "expr": "z^n"
    }
  ],
  "prompt": "次の式を計算しなさい。",
  "math": "({z})^{{n}}",
  "answer": "${w}$",
  "checks": [
    {
      "kind": "identity",
      "left": "({z})^{{n}}",
      "right": "{w}"
    },
    {
      "kind": "assert",
      "conditions": [
        "abs(w) == 2^n"
      ]
    }
  ]
}
