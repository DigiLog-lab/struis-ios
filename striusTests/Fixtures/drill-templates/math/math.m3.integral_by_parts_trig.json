{
  "format": 1,
  "skill_id": "math.m3.integral_by_parts_trig",
  "title": "部分積分(x sin ax、x cos ax)",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "k",
      "kind": "integer",
      "min": 1,
      "max": 5
    },
    {
      "name": "fn",
      "kind": "choice",
      "options": [
        {
          "f": "\\sin",
          "g1": "\\cos",
          "g2": "\\sin",
          "s1": -1,
          "s2": 1
        },
        {
          "f": "\\cos",
          "g1": "\\sin",
          "g2": "\\cos",
          "s1": 1,
          "s2": 1
        }
      ]
    }
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "k",
          "body": "x{fn.f} {a|coef}x"
        }
      ]
    },
    {
      "name": "g",
      "kind": "sum",
      "terms": [
        {
          "coef": "fn.s1*k/a",
          "body": "x{fn.g1} {a|coef}x"
        },
        {
          "coef": "fn.s2*k/a^2",
          "body": "{fn.g2} {a|coef}x"
        },
        {
          "coef": "1",
          "body": "C"
        }
      ]
    }
  ],
  "prompt": "次の不定積分を求めなさい。",
  "math": "\\int {f}\\,dx",
  "answer": "${g}$($C$ は積分定数)",
  "checks": [
    {
      "kind": "antiderivative",
      "integrand": "{f}",
      "answer": "{g}",
      "variable": "x"
    }
  ]
}
