{
  "format": 1,
  "skill_id": "math.m2.logarithm_properties",
  "title": "対数の性質を使った計算",
  "subject": "math",
  "variables": [
    {
      "name": "b",
      "kind": "choice",
      "options": [
        2,
        3,
        5,
        6,
        10
      ]
    },
    {
      "name": "p",
      "kind": "integer",
      "min": 2,
      "max": 9
    },
    {
      "name": "q",
      "kind": "integer",
      "min": 2,
      "max": 9
    },
    {
      "name": "k",
      "kind": "integer",
      "min": 1,
      "max": 3
    }
  ],
  "lets": [
    {
      "name": "m",
      "expr": "b^k * q / p"
    }
  ],
  "constraints": [
    "mod(b^k * q, p) == 0",
    "p != q",
    "b^k*q/p != p",
    "b^k*q/p > 1"
  ],
  "prompt": "次の計算をしなさい。",
  "math": "\\log_{{b}} {m} + \\log_{{b}} {p} - \\log_{{b}} {q}",
  "answer": "${k}$",
  "checks": [
    {
      "kind": "identity",
      "left": "\\log_{{b}} {m} + \\log_{{b}} {p} - \\log_{{b}} {q}",
      "right": "{k}"
    }
  ]
}
