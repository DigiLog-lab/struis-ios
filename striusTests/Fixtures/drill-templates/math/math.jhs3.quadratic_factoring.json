      "terms": [
        {
          "coef": "1",
          "body": "x^{2}"
        },
        {
          "coef": "-(r1+r2)",
          "body": "x"
        },
        {
          "coef": "r1*r2"
        }
      ]
    },
    {
      "name": "roots",
      "kind": "list",
      "items": [
        "r1",
        "r2"
      ],
      "sort": true,
      "unique": true
    }
  ],
  "prompt": "次の方程式を解きなさい。",
  "math": "{f} = 0",
  "answer": "$x = {roots}$",
  "checks": [
    {
      "kind": "root",
      "left": "{f}",
      "variable": "x",
      "solutions": [
        "{roots}"
      ]
    }
  ]
