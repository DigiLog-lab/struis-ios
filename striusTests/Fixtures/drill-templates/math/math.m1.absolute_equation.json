{
  "format": 1,
  "skill_id": "math.m1.absolute_equation",
  "title": "絶対値をふくむ方程式",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0
      ]
    },
    {
      "name": "b",
      "kind": "integer",
      "min": 1,
      "max": 12
    }
  ],
  "parts": [
    {
      "name": "inner",
      "kind": "sum",
      "terms": [
        {
          "coef": "1",
          "body": "x"
        },
        {
          "coef": "-a"
        }
      ]
    },
    {
      "name": "roots",
      "kind": "list",
      "items": [
        "a - b",
        "a + b"
      ],
      "sort": true,
      "unique": true
    }
  ],
  "prompt": "次の方程式を解きなさい。",
  "math": "|{inner}| = {b}",
  "answer": "$x = {roots}$",
  "checks": [
    {
      "kind": "root",
      "left": "|{inner}|",
      "right": "{b}",
      "variable": "x",
      "solutions": [
        "{roots}"
      ]
    }
  ]
}
