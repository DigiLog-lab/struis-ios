      ]
    }
  ],
  "constraints": [
    "gcd(k, abs(a)) == 1"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "k^3",
          "body": "x^{3}"
        },
        {
          "coef": "a^3"
        }
      ]
    },
    {
      "name": "p",
      "kind": "sum",
      "terms": [
        {
          "coef": "k",
          "body": "x"
        },
        {
          "coef": "a"
        }
      ]
    },
    {
      "name": "q",
      "kind": "sum",
      "terms": [
        {
          "coef": "k^2",
          "body": "x^{2}"
        },
        {
          "coef": "-k*a",
          "body": "x"
        },
        {
          "coef": "a^2"
        }
      ]
    }
  ],
  "prompt": "次の式を因数分解しなさい。",
  "math": "{f}",
  "answer": "$({p})({q})$",
  "checks": [
    {
      "kind": "identity",
      "left": "{f}",
      "right": "({p})({q})"
    }
  ]
}
