{
  "format": 1,
  "skill_id": "math.m2.factor_sum_of_cubes",
  "title": "x³ ± a³ の因数分解",
  "subject": "math",
  "variables": [
    {
      "name": "k",
      "kind": "integer",
      "min": 1,
      "max": 3
    },
    {
