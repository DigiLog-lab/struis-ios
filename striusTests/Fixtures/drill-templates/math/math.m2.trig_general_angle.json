{
  "format": 1,
  "skill_id": "math.m2.trig_general_angle",
  "title": "一般角の三角関数の値(弧度法)",
  "subject": "math",
  "variables": [
    {
      "name": "fn",
      "kind": "choice",
      "options": [
        {
          "tex": "\\sin",
          "k": 1
        },
        {
          "tex": "\\cos",
          "k": 2
        },
        {
          "tex": "\\tan",
          "k": 3
        }
      ]
    },
    {
      "name": "deg",
      "kind": "choice",
      "options": [
        120,
        135,
        150,
        210,
        225,
        240,
        300,
        315,
        330,
        -30,
        -45,
        -60,
        -120,
        -135,
        -150,
        390,
        405,
        420
      ]
    }
  ],
  "lets": [
    {
      "name": "rad",
      "expr": "deg/180"
    },
    {
      "name": "v",
      "expr": "if(fn.k == 1, sind(deg), if(fn.k == 2, cosd(deg), tand(deg)))"
    }
  ],
  "prompt": "次の値を求めなさい。",
  "math": "{fn.tex} {rad|paren|pi}",
  "answer": "${v}$",
  "checks": [
    {
      "kind": "identity",
      "left": "{fn.tex} ({rad|pi})",
      "right": "{v}"
    }
  ]
}
