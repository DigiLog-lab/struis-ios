{
  "format": 1,
  "skill_id": "math.m2.change_of_base",
  "title": "底の変換公式",
  "subject": "math",
  "variables": [
    {
      "name": "b",
      "kind": "choice",
      "options": [
        2,
        3,
        5
      ]
    },
    {
      "name": "m",
      "kind": "integer",
      "min": 1,
      "max": 4
    },
    {
      "name": "n",
      "kind": "integer",
      "min": 1,
      "max": 5
    }
  ],
  "lets": [
    {
      "name": "base",
      "expr": "b^m"
    },
    {
      "name": "arg",
      "expr": "b^n"
    },
    {
      "name": "ans",
      "expr": "n/m"
    }
  ],
  "constraints": [
    "m != n",
    "gcd(m, n) == 1 or m == 1",
    "b^m <= 243",
    "b^n <= 3125",
    "m >= 2"
  ],
  "prompt": "次の値を求めなさい。",
  "math": "\\log_{{base}} {arg}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "identity",
      "left": "\\log_{{base}} {arg}",
      "right": "{ans}"
    }
  ]
}
