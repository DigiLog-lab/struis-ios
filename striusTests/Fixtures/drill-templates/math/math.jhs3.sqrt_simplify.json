      "name": "n",
      "expr": "k^2*m"
    },
    {
      "name": "r",
      "expr": "sqrt(n)"
    }
  ],
  "prompt": "$\\sqrt{{n}}$ を $a\\sqrt{b}$ の形に変形しなさい。",
