{
  "format": 1,
  "skill_id": "math.m1.quadratic_inequality",
  "title": "二次不等式",
  "subject": "math",
  "variables": [
    {
      "name": "r1",
      "kind": "integer",
      "min": -8,
      "max": 8
    },
    {
      "name": "r2",
      "kind": "integer",
      "min": -8,
      "max": 8
    },
    {
      "name": "rel",
      "kind": "choice",
      "options": [
        {
          "tex": "<",
          "t": 1
        },
        {
          "tex": "\\le",
          "t": 2
        },
        {
          "tex": ">",
          "t": 3
        },
        {
          "tex": "\\ge",
          "t": 4
        }
      ]
    }
  ],
  "constraints": [
    "r1 < r2"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "1",
          "body": "x^{2}"
        },
        {
          "coef": "-(r1+r2)",
          "body": "x"
        },
        {
          "coef": "r1*r2"
        }
      ]
    },
    {
      "name": "sol",
      "kind": "select",
      "cases": [
        {
          "when": "rel.t == 1",
          "tex": "{r1} < x < {r2}"
        },
        {
          "when": "rel.t == 2",
          "tex": "{r1} \\le x \\le {r2}"
        },
        {
          "when": "rel.t == 3",
          "tex": "x < {r1},\\ {r2} < x"
        }
      ],
      "otherwise": "x \\le {r1},\\ {r2} \\le x"
    }
  ],
  "prompt": "次の二次不等式を解きなさい。",
  "math": "{f} {rel.tex} 0",
  "answer": "${sol}$",
  "checks": [
    {
      "kind": "inequality",
      "left": "{f}",
      "right": "0",
      "relation": "{rel.tex}",
      "variable": "x",
      "solution": "if(rel.t <= 2, r1 < x and x < r2, x < r1 or x > r2)"
    }
  ]
}
