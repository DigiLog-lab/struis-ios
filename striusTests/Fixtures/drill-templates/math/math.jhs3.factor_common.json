{
  "format": 1,
  "skill_id": "math.jhs3.factor_common",
  "title": "共通因数をくくり出す",
  "subject": "math",
  "variables": [
    {
      "name": "k",
      "kind": "integer",
      "min": 2,
      "max": 9
    },
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 7
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -7,
      "max": 7,
      "exclude": [
        0
      ]
    },
    {
      "name": "m",
      "kind": "integer",
      "min": 1,
      "max": 2
    }
  ],
  "constraints": [
    "gcd(a, abs(b)) == 1"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "k*a",
          "powers": [
            {
              "base": "x",
              "exp": "m+1"
            }
          ]
        },
        {
          "coef": "k*b",
          "powers": [
            {
              "base": "x",
              "exp": "m"
            }
          ]
        }
      ]
    },
    {
      "name": "inner",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x"
        },
        {
          "coef": "b"
        }
      ]
    },
    {
      "name": "mono",
      "kind": "sum",
      "terms": [
        {
          "coef": "k",
          "powers": [
            {
              "base": "x",
              "exp": "m"
            }
          ]
        }
      ]
    }
  ],
  "prompt": "次の式を因数分解しなさい。",
  "math": "{f}",
  "answer": "${mono}({inner})$",
  "checks": [
    {
      "kind": "identity",
      "left": "{f}",
      "right": "{mono}({inner})"
    }
  ]
}
