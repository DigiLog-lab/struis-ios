{
  "format": 1,
  "skill_id": "math.m2.point_line_distance",
  "title": "点と直線の距離",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "c",
      "kind": "integer",
      "min": -9,
      "max": 9
    },
    {
      "name": "x1",
      "kind": "integer",
      "min": -6,
      "max": 6
    },
    {
      "name": "y1",
      "kind": "integer",
      "min": -6,
      "max": 6
    }
  ],
  "lets": [
    {
      "name": "d",
      "expr": "abs(a*x1 + b*y1 + c)/sqrt(a^2 + b^2)"
    }
  ],
  "constraints": [
    "gcd(a, abs(b)) == 1",
    "a*x1 + b*y1 + c != 0"
  ],
  "parts": [
    {
      "name": "line",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x"
        },
        {
          "coef": "b",
          "body": "y"
        },
        {
          "coef": "c"
        }
      ]
    }
  ],
  "prompt": "点 $({x1},\\ {y1})$ と直線 ${line} = 0$ の距離を求めなさい。",
  "answer": "${d}$",
  "checks": [
    {
      "kind": "identity",
      "left": "{d}",
      "right": "\\frac{|{a} \\cdot ({x1}) + ({b}) \\cdot ({y1}) + ({c})|}{\\sqrt{{a}^{2} + ({b})^{2}}}"
    }
  ]
}
