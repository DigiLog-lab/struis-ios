{
  "format": 1,
  "skill_id": "math.m1.parabola_translation",
  "title": "放物線の平行移動",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": -3,
      "max": 3,
      "exclude": [
        0
      ]
    },
    {
      "name": "h",
      "kind": "integer",
      "min": -5,
      "max": 5,
      "exclude": [
        0
      ]
    },
    {
      "name": "k",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    }
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x^{2}"
        }
      ]
    },
    {
      "name": "inner",
      "kind": "sum",
      "terms": [
        {
          "coef": "1",
          "body": "x"
        },
        {
          "coef": "-h"
        }
      ]
    },
    {
      "name": "g",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "({inner})^{2}"
        },
        {
          "coef": "k"
        }
      ]
    },
    {
      "name": "ex",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x^{2}"
        },
        {
          "coef": "-2*a*h",
          "body": "x"
        },
        {
          "coef": "a*h^2 + k"
        }
      ]
    }
  ],
  "prompt": "放物線 $y = {f}$ を、$x$ 軸方向に ${h}$、$y$ 軸方向に ${k}$ だけ平行移動した放物線の方程式を求めなさい。",
  "answer": "$y = {g}$(展開すると $y = {ex}$)",
  "checks": [
    {
      "kind": "identity",
      "left": "{g}",
      "right": "{ex}"
    },
    {
      "kind": "identity",
      "left": "{g}",
      "right": "({a|paren})(x - {h|paren})^{2} + {k|paren}"
    }
  ]
}
