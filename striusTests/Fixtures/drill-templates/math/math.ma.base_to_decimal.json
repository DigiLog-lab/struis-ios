{
  "format": 1,
  "skill_id": "math.ma.base_to_decimal",
  "title": "n 進法から 10 進法へ",
  "subject": "math",
  "variables": [
    {
      "name": "n",
      "kind": "integer",
      "min": 5,
      "max": 255
    },
    {
      "name": "base",
      "kind": "choice",
      "options": [
        2,
        3,
        5
      ]
    }
  ],
  "lets": [
    {
      "name": "digits",
      "expr": "to_base(n, base)"
    }
  ],
  "constraints": [
    "n >= base^2",
    "to_base(n, base) <= 111111111"
  ],
  "prompt": "${base}$ 進法で表された数 ${digits}_{({base})}$ を 10 進法で表しなさい。",
  "answer": "${n}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "to_base(n, base) == digits"
      ]
    }
  ]
}
