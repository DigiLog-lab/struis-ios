        }
      ]
    },
    {
      "name": "mult",
      "kind": "choice",
      "options": [
        1,
        2
      ]
    }
  ],
  "lets": [
    {
      "name": "v",
      "expr": "if(eq.k == 1, sind(eq.d1), if(eq.k == 2, cosd(eq.d1), tand(eq.d1)))"
    },
    {
      "name": "rhs",
      "expr": "mult*v"
    },
    {
      "name": "t1",
      "expr": "eq.d1/180"
    },
    {
      "name": "t2",
      "expr": "eq.d2/180"
    }
  ],
  "constraints": [
    "mult == 1 or eq.k != 3"
  ],
  "parts": [
    {
      "name": "lhs",
      "kind": "select",
      "cases": [
        {
          "when": "mult == 1",
          "tex": "{eq.fn}\\theta"
        }
      ],
      "otherwise": "{mult}{eq.fn}\\theta"
    }
  ],
  "prompt": "$0 \\le \\theta < 2\\pi$ のとき、次の方程式を解きなさい。",
  "math": "{lhs} = {rhs}",
  "answer": "$\\theta = {t1|pi},\\ {t2|pi}$",
  "checks": [
    {
      "kind": "root",
      "left": "{lhs}",
      "right": "{rhs}",
      "variable": "theta",
      "solutions": [
        "{t1|pi}",
        "{t2|pi}"
      ]
    }
  ]
}
