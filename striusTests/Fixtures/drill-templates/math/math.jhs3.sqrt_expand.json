{
  "format": 1,
  "skill_id": "math.jhs3.sqrt_expand",
  "title": "平方根をふくむ式の展開",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "choice",
      "options": [
        2,
        3,
        5,
        6,
        7
      ]
    },
    {
      "name": "b",
      "kind": "choice",
      "options": [
        2,
        3,
        5,
        7
      ]
    },
    {
      "name": "k",
      "kind": "integer",
      "min": 1,
      "max": 4
    }
  ],
  "lets": [
    {
      "name": "ans",
      "expr": "(sqrt(a) + k*sqrt(b))^2"
    }
  ],
  "constraints": [
    "a != b"
  ],
  "prompt": "次の計算をしなさい。",
  "math": "(\\sqrt{{a}} + {k|coef}\\sqrt{{b}})^{2}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "identity",
      "left": "(\\sqrt{{a}} + {k|coef}\\sqrt{{b}})^{2}",
      "right": "{ans}"
    }
  ]
}
