{
  "format": 1,
  "skill_id": "math.m1.absolute_inequality",
  "title": "絶対値をふくむ不等式",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0
      ]
    },
    {
      "name": "b",
      "kind": "integer",
      "min": 1,
      "max": 12
    },
    {
      "name": "rel",
      "kind": "choice",
      "options": [
        {
          "tex": "<",
          "inside": 1
        },
        {
          "tex": ">",
          "inside": 0
        }
      ]
    }
  ],
  "lets": [
    {
      "name": "lo",
      "expr": "a - b"
    },
    {
      "name": "hi",
      "expr": "a + b"
    }
  ],
  "parts": [
    {
      "name": "inner",
      "kind": "sum",
      "terms": [
        {
          "coef": "1",
          "body": "x"
        },
        {
          "coef": "-a"
        }
      ]
    },
    {
      "name": "sol",
      "kind": "select",
      "cases": [
        {
          "when": "rel.inside == 1",
          "tex": "{lo} < x < {hi}"
        }
      ],
      "otherwise": "x < {lo},\\ {hi} < x"
    }
  ],
  "prompt": "次の不等式を解きなさい。",
  "math": "|{inner}| {rel.tex} {b}",
  "answer": "${sol}$",
  "checks": [
    {
      "kind": "inequality",
      "left": "|{inner}|",
      "right": "{b}",
      "relation": "{rel.tex}",
      "variable": "x",
      "solution": "if(rel.inside == 1, lo < x and x < hi, x < lo or x > hi)"
    }
  ]
}
