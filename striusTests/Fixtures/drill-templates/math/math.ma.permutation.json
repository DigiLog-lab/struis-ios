{
  "format": 1,
  "skill_id": "math.ma.permutation",
  "title": "順列 nPr の計算",
  "subject": "math",
  "variables": [
    {
      "name": "n",
      "kind": "integer",
      "min": 4,
      "max": 12
    },
    {
      "name": "r",
      "kind": "integer",
      "min": 2,
      "max": 5
    }
  ],
  "lets": [
    {
      "name": "ans",
      "expr": "perm(n, r)"
    }
  ],
  "constraints": [
    "r <= n"
  ],
  "prompt": "次の値を求めなさい。",
  "math": "{}_{{n}}\\mathrm{P}_{{r}}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "ans * factorial(n - r) == factorial(n)"
      ]
    }
  ]
}
