{
  "format": 1,
  "skill_id": "math.m2.area_parabola_line",
  "title": "放物線と直線で囲まれた部分の面積",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "choice",
      "options": [
        1,
        2,
        -1,
        -2
      ]
    },
    {
      "name": "r1",
      "kind": "integer",
      "min": -4,
      "max": 3
    },
    {
      "name": "w",
      "kind": "integer",
      "min": 1,
      "max": 5
    },
    {
      "name": "m",
      "kind": "integer",
      "min": -3,
      "max": 3
    },
    {
      "name": "k",
      "kind": "integer",
      "min": -5,
      "max": 5
    }
  ],
  "lets": [
    {
      "name": "r2",
      "expr": "r1 + w"
    },
    {
      "name": "area",
      "expr": "abs(a)*w^3/6"
    }
  ],
  "constraints": [
    "m != 0 or k != 0"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x^{2}"
        },
        {
          "coef": "m - a*(r1 + r2)",
          "body": "x"
        },
        {
          "coef": "k + a*r1*r2"
        }
      ]
    },
    {
      "name": "g",
      "kind": "sum",
      "terms": [
        {
          "coef": "m",
          "body": "x"
        },
        {
          "coef": "k"
        }
      ]
    }
  ],
  "prompt": "放物線 $y = {f}$ と直線 $y = {g}$ で囲まれた部分の面積を求めなさい。",
  "answer": "${area}$",
  "checks": [
    {
      "kind": "definite_integral",
      "integrand": "|({f}) - ({g})|",
      "variable": "x",
      "from": "r1",
      "to": "r2",
      "answer": "{area}"
    },
    {
      "kind": "root",
      "left": "{f}",
      "right": "{g}",
      "variable": "x",
      "solutions": [
        "{r1}",
        "{r2}"
      ]
    }
  ]
}
