{
  "format": 1,
  "skill_id": "math.mb.geometric_sum",
  "title": "等比数列の和",
  "subject": "math",
  "variables": [
    {
      "name": "a1",
      "kind": "integer",
      "min": 1,
      "max": 5
    },
    {
      "name": "r",
      "kind": "choice",
      "options": [
        2,
        3,
        -2,
        -3,
        4
      ]
    },
    {
      "name": "n0",
      "kind": "integer",
      "min": 3,
      "max": 8
    }
  ],
  "lets": [
    {
      "name": "sum",
      "expr": "a1*(r^n0 - 1)/(r - 1)"
    }
  ],
  "constraints": [
    "abs(sum) <= 50000"
  ],
  "prompt": "初項 ${a1}$、公比 ${r}$ の等比数列の、初項から第 ${n0}$ 項までの和を求めなさい。",
  "answer": "${sum}$",
  "checks": [
    {
      "kind": "series",
      "term": "{a1} \\cdot {r|paren}^{k-1}",
      "index": "k",
      "from": "1",
      "to": "n0",
      "answer": "{sum}"
    }
  ]
}
