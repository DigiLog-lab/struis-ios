{
  "format": 1,
  "skill_id": "math.jhs3.similarity_ratio",
  "title": "相似比から面積比・体積比を求める",
  "subject": "math",
  "variables": [
    {
      "name": "m",
      "kind": "integer",
      "min": 1,
      "max": 9
    },
    {
      "name": "n",
      "kind": "integer",
      "min": 1,
      "max": 9
    }
  ],
  "lets": [
    {
      "name": "m2",
      "expr": "m^2"
    },
    {
      "name": "n2",
      "expr": "n^2"
    },
    {
      "name": "m3",
      "expr": "m^3"
    },
    {
      "name": "n3",
      "expr": "n^3"
    }
  ],
  "constraints": [
    "m < n",
    "gcd(m,n) == 1"
  ],
  "prompt": "相似な 2 つの立体があり、相似比は ${m} : {n}$ である。表面積の比と体積の比を求めなさい。",
  "answer": "表面積の比 ${m2} : {n2}$、体積の比 ${m3} : {n3}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "m2*n^2 == n2*m^2",
        "m3*n^3 == n3*m^3"
      ]
    }
  ]
}
