{
  "format": 1,
  "skill_id": "math.jhs3.rationalize",
  "title": "分母の有理化",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 12
    },
    {
      "name": "b",
      "kind": "choice",
      "options": [
        2,
        3,
        5,
        6,
        7,
        10
      ]
    }
  ],
  "lets": [
    {
      "name": "ans",
      "expr": "a/sqrt(b)"
    }
  ],
  "prompt": "次の数の分母を有理化しなさい。",
  "math": "\\frac{{a}}{\\sqrt{{b}}}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "identity",
      "left": "\\frac{{a}}{\\sqrt{{b}}}",
      "right": "{ans}"
    }
  ]
}
