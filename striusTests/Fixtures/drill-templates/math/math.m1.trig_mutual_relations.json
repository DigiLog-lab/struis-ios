          "a": 40,
          "h": 41
        }
      ]
    },
    {
      "name": "quad",
      "kind": "choice",
      "options": [
        {
          "text": "0^{\\circ} < \\theta < 90^{\\circ}",
          "s": 1
        },
        {
          "text": "90^{\\circ} < \\theta < 180^{\\circ}",
          "s": -1
        }
      ]
    }
  ],
  "lets": [
    {
      "name": "sinv",
      "expr": "tri.o/tri.h"
    },
    {
      "name": "cosv",
      "expr": "quad.s*tri.a/tri.h"
    },
    {
      "name": "tanv",
      "expr": "sinv/cosv"
    }
  ],
  "prompt": "${quad.text}$ で $\\sin\\theta = {sinv}$ のとき、$\\cos\\theta$ と $\\tan\\theta$ の値を求めなさい。",
  "answer": "$\\cos\\theta = {cosv}$、$\\tan\\theta = {tanv}$",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "sinv^2 + cosv^2 == 1",
        "tanv*cosv == sinv",
        "sign(cosv) == quad.s"
      ]
    }
  ]
}
