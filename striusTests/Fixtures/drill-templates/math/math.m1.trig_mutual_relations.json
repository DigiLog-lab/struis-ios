{
  "format": 1,
  "skill_id": "math.m1.trig_mutual_relations",
  "title": "三角比の相互関係(sin から cos・tan)",
  "subject": "math",
  "variables": [
    {
      "name": "tri",
      "kind": "choice",
      "options": [
        {
          "o": 3,
          "a": 4,
          "h": 5
