{
  "format": 1,
  "skill_id": "math.m1.parabola_x_intercepts",
  "title": "放物線と x 軸の共有点の座標",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 3
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -9,
      "max": 9
