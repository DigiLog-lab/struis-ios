{
  "format": 1,
  "skill_id": "math.jhs2.simultaneous_elimination",
  "title": "連立方程式(加減法)",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "c",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "d",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "x0",
      "kind": "integer",
      "min": -7,
      "max": 7
    },
    {
      "name": "y0",
      "kind": "integer",
      "min": -7,
      "max": 7
    }
  ],
  "lets": [
    {
      "name": "p",
      "expr": "a*x0 + b*y0"
    },
    {
      "name": "r",
      "expr": "c*x0 + d*y0"
    }
  ],
  "constraints": [
    "a*d - b*c != 0"
  ],
  "parts": [
    {
      "name": "l1",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x"
        },
        {
          "coef": "b",
          "body": "y"
        }
      ]
    },
    {
      "name": "l2",
      "kind": "sum",
      "terms": [
        {
          "coef": "c",
          "body": "x"
        },
        {
          "coef": "d",
          "body": "y"
        }
      ]
    }
  ],
  "prompt": "次の連立方程式を解きなさい。",
  "math": "\\begin{cases} {l1} = {p} \\\\ {l2} = {r} \\end{cases}",
  "answer": "$x = {x0},\\ y = {y0}$",
  "checks": [
    {
      "kind": "system",
      "equations": [
        {
          "left": "{l1}",
          "right": "{p}"
        },
        {
          "left": "{l2}",
          "right": "{r}"
        }
      ],
      "values": {
        "x": "{x0}",
        "y": "{y0}"
      }
    }
  ]
}
