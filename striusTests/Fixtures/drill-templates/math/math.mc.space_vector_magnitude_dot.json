{
  "format": 1,
  "skill_id": "math.mc.space_vector_magnitude_dot",
  "title": "空間ベクトルの大きさと内積",
  "subject": "math",
  "variables": [
    {
      "name": "a1",
      "kind": "integer",
      "min": -5,
      "max": 5
    },
    {
      "name": "a2",
      "kind": "integer",
      "min": -5,
      "max": 5
    },
    {
      "name": "a3",
      "kind": "integer",
      "min": -5,
      "max": 5,
      "exclude": [
        0
      ]
    },
    {
      "name": "b1",
      "kind": "integer",
      "min": -5,
      "max": 5
    },
    {
      "name": "b2",
      "kind": "integer",
      "min": -5,
      "max": 5,
      "exclude": [
        0
      ]
    },
    {
      "name": "b3",
      "kind": "integer",
      "min": -5,
      "max": 5
    }
  ],
  "lets": [
    {
      "name": "len",
      "expr": "sqrt(a1^2 + a2^2 + a3^2)"
    },
    {
      "name": "dot",
      "expr": "a1*b1 + a2*b2 + a3*b3"
    }
  ],
  "prompt": "$\\vec{a} = ({a1},\\ {a2},\\ {a3})$、$\\vec{b} = ({b1},\\ {b2},\\ {b3})$ のとき、$|\\vec{a}|$ と $\\vec{a} \\cdot \\vec{b}$ を求めなさい。",
  "answer": "$|\\vec{a}| = {len}$、$\\vec{a} \\cdot \\vec{b} = {dot}$",
  "checks": [
    {
      "kind": "identity",
      "left": "({len})^{2}",
      "right": "({a1})^{2} + ({a2})^{2} + ({a3})^{2}"
    },
    {
      "kind": "value",
      "tex": "{a1|paren} \\times {b1|paren} + {a2|paren} \\times {b2|paren} + {a3|paren} \\times {b3|paren}",
      "equals": "dot"
    }
  ]
}
