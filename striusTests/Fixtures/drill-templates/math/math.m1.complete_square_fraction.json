{
  "format": 1,
  "skill_id": "math.m1.complete_square_fraction",
  "title": "平方完成(頂点が分数になる)",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 2
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0
      ]
    },
    {
      "name": "c",
      "kind": "integer",
      "min": -9,
      "max": 9
    }
  ],
  "lets": [
    {
      "name": "p",
      "expr": "-b/(2*a)"
    },
    {
      "name": "q",
      "expr": "c - b^2/(4*a)"
    }
  ],
  "constraints": [
    "mod(b, 2*a) != 0"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x^{2}"
        },
        {
          "coef": "b",
          "body": "x"
        },
        {
          "coef": "c"
        }
      ]
    },
    {
      "name": "inner",
      "kind": "sum",
      "terms": [
        {
          "coef": "1",
          "body": "x"
        },
        {
          "coef": "-p"
        }
      ]
    },
    {
      "name": "g",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "({inner})^{2}"
        },
        {
          "coef": "q"
        }
      ]
    }
  ],
  "prompt": "次の二次関数を $y = a(x - p)^{2} + q$ の形に変形しなさい。",
  "math": "y = {f}",
  "answer": "$y = {g}$",
  "checks": [
    {
      "kind": "identity",
      "left": "{f}",
      "right": "{g}"
    }
  ]
}
