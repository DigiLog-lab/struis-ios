{
  "format": 1,
  "skill_id": "math.jhs2.simultaneous_substitution",
  "title": "連立方程式(代入法)",
  "subject": "math",
  "variables": [
    {
      "name": "m",
      "kind": "integer",
      "min": -5,
      "max": 5,
      "exclude": [
        0
      ]
    },
    {
      "name": "k",
      "kind": "integer",
      "min": -9,
      "max": 9
    },
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "x0",
      "kind": "integer",
      "min": -7,
      "max": 7
    }
  ],
  "lets": [
    {
      "name": "y0",
      "expr": "m*x0 + k"
    },
    {
      "name": "p",
      "expr": "a*x0 + b*y0"
    }
  ],
  "constraints": [
    "a + b*m != 0",
    "abs(y0) <= 20"
  ],
  "parts": [
    {
      "name": "rhs",
      "kind": "sum",
      "terms": [
        {
          "coef": "m",
          "body": "x"
        },
        {
          "coef": "k"
        }
      ]
    },
    {
      "name": "l2",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x"
        },
        {
          "coef": "b",
          "body": "y"
        }
      ]
    }
  ],
  "prompt": "次の連立方程式を解きなさい。",
  "math": "\\begin{cases} y = {rhs} \\\\ {l2} = {p} \\end{cases}",
  "answer": "$x = {x0},\\ y = {y0}$",
  "checks": [
    {
      "kind": "system",
      "equations": [
        {
          "left": "y",
          "right": "{rhs}"
        },
        {
          "left": "{l2}",
          "right": "{p}"
        }
      ],
      "values": {
        "x": "{x0}",
        "y": "{y0}"
      }
    }
  ]
}
