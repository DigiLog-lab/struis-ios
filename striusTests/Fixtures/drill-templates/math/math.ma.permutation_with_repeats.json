{
  "format": 1,
  "skill_id": "math.ma.permutation_with_repeats",
  "title": "同じものをふくむ順列",
  "subject": "math",
  "variables": [
    {
      "name": "p",
      "kind": "integer",
      "min": 2,
      "max": 4
    },
    {
      "name": "q",
      "kind": "integer",
      "min": 1,
      "max": 4
    },
    {
      "name": "r",
      "kind": "integer",
      "min": 1,
      "max": 3
    }
  ],
  "lets": [
    {
      "name": "n",
      "expr": "p + q + r"
    },
    {
      "name": "ans",
      "expr": "factorial(n)/(factorial(p)*factorial(q)*factorial(r))"
    }
  ],
  "constraints": [
    "p + q + r <= 9"
  ],
  "prompt": "a が ${p}$ 個、b が ${q}$ 個、c が ${r}$ 個ある。この ${n}$ 個の文字を 1 列に並べる方法は何通りあるか。",
  "answer": "${ans}$ 通り",
  "checks": [
    {
      "kind": "assert",
      "conditions": [
        "ans == comb(n, p) * comb(n - p, q)"
      ]
    }
  ]
}
