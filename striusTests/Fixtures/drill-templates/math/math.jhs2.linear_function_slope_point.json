{
  "format": 1,
  "skill_id": "math.jhs2.linear_function_slope_point",
  "title": "傾きと 1 点から一次関数の式を求める",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "fraction",
      "numerator": {
        "min": -9,
        "max": 9
      },
      "denominator": {
        "min": 1,
        "max": 3
      }
    },
    {
      "name": "x1",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0
      ]
    },
    {
      "name": "y1",
      "kind": "integer",
      "min": -9,
      "max": 9
    }
  ],
  "lets": [
    {
      "name": "b",
      "expr": "y1 - a*x1"
    }
  ],
  "constraints": [
    "is_integer(b)"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x"
        },
        {
          "coef": "b"
        }
      ]
    }
  ],
  "prompt": "傾きが ${a}$ で、点 $({x1},\\ {y1})$ を通る直線の式を求めなさい。",
  "answer": "$y = {f}$",
  "checks": [
    {
      "kind": "value",
      "tex": "{f}",
      "at": {
        "x": "x1"
      },
      "equals": "y1"
    },
    {
      "kind": "derivative",
      "function": "{f}",
      "variable": "x",
      "point": "0",
      "answer": "{a}"
    }
  ]
}
