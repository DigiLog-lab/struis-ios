{
  "format": 1,
  "skill_id": "math.m2.quadratic_complex_roots",
  "title": "二次方程式の虚数解",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": 1,
      "max": 3
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -6,
      "max": 6
    },
    {
      "name": "c",
      "kind": "integer",
      "min": 1,
      "max": 9
    }
  ],
  "lets": [
    {
      "name": "disc",
      "expr": "b^2 - 4*a*c"
    }
  ],
  "constraints": [
    "disc < 0",
    "gcd(a, gcd(abs(b), c)) == 1"
  ],
  "parts": [
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "a",
          "body": "x^{2}"
        },
        {
          "coef": "b",
          "body": "x"
        },
        {
          "coef": "c"
        }
      ]
    },
    {
      "name": "roots",
      "kind": "pm",
      "center": "-b/(2*a)",
      "radicand": "disc",
      "scale": "1/(2*a)"
    }
  ],
  "prompt": "次の二次方程式を解きなさい。",
  "math": "{f} = 0",
  "answer": "$x = {roots}$",
  "checks": [
    {
      "kind": "root",
      "left": "{f}",
      "variable": "x",
      "solutions": [
        "{roots}"
      ]
    }
  ]
}
