{
  "format": 1,
  "skill_id": "math.m3.integral_exp_trig",
  "title": "不定積分(e^{ax}、sin ax、cos ax)",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": -6,
      "max": 6,
      "exclude": [
        0,
        1
      ]
    },
    {
      "name": "k",
      "kind": "integer",
      "min": 1,
      "max": 6
    },
    {
      "name": "fn",
      "kind": "choice",
      "options": [
        {
          "t": 1
        },
        {
          "t": 2
        },
        {
          "t": 3
        }
      ]
    }
  ],
  "parts": [
    {
      "name": "body",
      "kind": "select",
      "cases": [
        {
          "when": "fn.t == 1",
          "tex": "e^{{a|coef}x}"
        },
        {
          "when": "fn.t == 2",
          "tex": "\\sin {a|coef}x"
        }
      ],
      "otherwise": "\\cos {a|coef}x"
    },
    {
      "name": "anti",
      "kind": "select",
      "cases": [
        {
          "when": "fn.t == 1",
          "tex": "e^{{a|coef}x}"
        },
        {
          "when": "fn.t == 2",
          "tex": "\\cos {a|coef}x"
        }
      ],
      "otherwise": "\\sin {a|coef}x"
    },
    {
      "name": "f",
      "kind": "sum",
      "terms": [
        {
          "coef": "k",
          "body": "{body}"
        }
      ]
    },
    {
      "name": "g",
      "kind": "sum",
      "terms": [
        {
          "coef": "if(fn.t == 2, -k/a, k/a)",
          "body": "{anti}"
        },
        {
          "coef": "1",
          "body": "C"
        }
      ]
    }
  ],
  "prompt": "次の不定積分を求めなさい。",
  "math": "\\int {f}\\,dx",
  "answer": "${g}$($C$ は積分定数)",
  "checks": [
    {
      "kind": "antiderivative",
      "integrand": "{f}",
      "answer": "{g}",
      "variable": "x",
      "range": [
        -0.5,
        0.5
      ]
    }
  ]
}
