{
  "format": 1,
  "skill_id": "math.m2.rational_exponent",
  "title": "累乗根と有理数の指数",
  "subject": "math",
  "variables": [
    {
      "name": "b",
      "kind": "choice",
      "options": [
        2,
        3,
        4,
        5
      ]
    },
    {
      "name": "p",
      "kind": "integer",
      "min": 1,
      "max": 3
    },
    {
      "name": "q",
      "kind": "choice",
      "options": [
        2,
        3
      ]
    },
    {
      "name": "k",
      "kind": "integer",
      "min": -2,
      "max": 3,
      "exclude": [
        0
      ]
    }
  ],
  "lets": [
    {
      "name": "base",
      "expr": "b^q"
    },
    {
      "name": "ex",
      "expr": "k/q"
    },
    {
      "name": "ans",
      "expr": "b^k"
    }
  ],
  "constraints": [
    "mod(k, q) != 0",
    "b^(p*q) <= 4096"
  ],
  "prompt": "次の値を求めなさい。",
  "math": "{base}^{{ex}}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "value",
      "tex": "{base}^{{ex}}",
      "equals": "ans"
    }
  ]
}
