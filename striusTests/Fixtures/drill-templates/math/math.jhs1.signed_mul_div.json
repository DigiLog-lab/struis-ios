{
  "format": 1,
  "skill_id": "math.jhs1.signed_mul_div",
  "title": "正負の数の乗法・除法",
  "subject": "math",
  "variables": [
    {
      "name": "a",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0
      ]
    },
    {
      "name": "b",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0,
        1
      ]
    },
    {
      "name": "q",
      "kind": "integer",
      "min": -9,
      "max": 9,
      "exclude": [
        0
      ]
    }
  ],
  "lets": [
    {
      "name": "n",
      "expr": "b*q"
    },
    {
      "name": "ans",
      "expr": "a*q"
    }
  ],
  "constraints": [
    "abs(n) <= 72"
  ],
  "prompt": "次の計算をしなさい。",
  "math": "{a|paren} \\times {n|paren} \\div {b|paren}",
  "answer": "${ans}$",
  "checks": [
    {
      "kind": "value",
      "tex": "{a|paren} \\times {n|paren} \\div {b|paren}",
      "equals": "ans"
    }
  ]
}
