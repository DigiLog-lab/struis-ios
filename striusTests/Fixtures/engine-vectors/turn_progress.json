     },
     {
      "status": "inProgress"
     }
    ]
   },
   "expect": []
  },
  {
   "name": "completed_ignored",
   "params": {
    "plan": [
     {
      "step": "画像を確認",
      "status": "completed"
     }
    ]
   },
   "expect": []
  }
 ],
