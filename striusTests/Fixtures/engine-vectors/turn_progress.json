 "progress_labels_from_plan": [
  {
   "name": "in_progress_image",
   "params": {
    "plan": [
     {
      "step": "画像を確認する",
      "status": "inProgress"
     },
     {
      "step": "答えを整理する",
      "status": "pending"
     }
    ]
   },
   "expect": [
    "画像を読んでいます…"
   ]
  },
  {
   "name": "pending_only_first",
   "params": {
    "plan": [
     {
      "step": "資料を読む",
      "status": "pending"
     },
     {
      "step": "検索する",
      "status": "pending"
     }
    ]
   },
   "expect": [
    "内容を読んでいます…"
   ]
  },
  {
   "name": "multiple_in_progress_dedup",
   "params": {
    "plan": [
     {
      "step": "履歴を見る",
      "status": "inProgress"
     },
     {
      "step": "前回の会話を確認",
      "status": "inProgress"
     },
     {
      "step": "検索",
      "status": "inProgress"
     }
    ]
   },
   "expect": [
    "前のやりとりを見ています…",
    "必要な情報を探しています…"
   ]
  },
  {
   "name": "no_plan",
   "params": {},
   "expect": []
  },
  {
   "name": "plan_not_list",
   "params": {
    "plan": "x"
   },
   "expect": []
  },
  {
   "name": "unlabeled_steps",
   "params": {
    "plan": [
     {
      "step": "zzz",
      "status": "inProgress"
     },
     {
      "step": "qqq",
      "status": "pending"
     }
    ]
   },
   "expect": []
  },
  {
   "name": "in_progress_unlabeled_falls_to_pending",
   "params": {
    "plan": [
     {
      "step": "zzz",
      "status": "inProgress"
     },
     {
      "step": "問題文を読む",
      "status": "pending"
     }
    ]
   },
   "expect": [
    "内容を読んでいます…"
   ]
  },
  {
   "name": "non_dict_steps",
   "params": {
    "plan": [
     "画像",
