   "input": "今日の内容を特定するために、直近の会話履歴だけ確認します。{\"\":\"今日やっていた物理は、重なった物体の力の復習ですね。物体1に働く力を上向き・下向きで書いてみてください。\", \"blocks\":[]}",
   "expect": "今日の内容を特定するために、直近の会話履歴だけ確認します。"
  },
  {
   "input": "わかりました。{\"blocks\":[]}",
   "expect": "わかりました。"
  },
  {
   "input": "返答では内部の整理作業は出しません。{\"message\":\"これはざっくり言うと、$\\varphi(x,y,z)$ が温度や高さみたいな値、$\\nabla\\varphi$ はその値が一番増える向きを向く矢印です。まずは $\\nabla\\varphi=(\\partial\\varphi/\\partial x,\\partial\\varphi/\\partial y,\\partial\\varphi/\\partial z)$ です。\",\"blocks\":[]}",
   "expect": "返答では内部の整理作業は出しません。"
  },
  {
   "input": "  ",
   "expect": ""
  },
  {
   "input": "本文<struis_progress_update>{}</struis_progress_update>",
   "expect": "本文<struis_progress_update>{}</struis_progress_update>"
  },
  {
   "input": "普通の返答です。",
   "expect": "普通の返答です。"
  },
  {
   "input": "前置き {\"message\": \"本文です\", \"wait_for_user\": true} 後置き",
   "expect": "前置き"
  },
  {
   "input": "{\"message\": \"\"} {\"message\": \"二番目\"}",
   "expect": ""
  },
  {
   "input": "{\"message\":\"\\u3042\\u3044 \\\"引用\\\" a\\/b \\n 改行",
   "expect": ""
  },
  {
   "input": "x {\"\":\"空キー本文",
   "expect": "x {\"\":\"空キー本文"
  },
  {
   "input": "数式 {\"x\": 1} と {\"y\": {\"z\": 2}} の説明",
   "expect": "数式 {\"x\": 1} と {\"y\": {\"z\": 2}} の説明"
  },
  {
   "input": "前 {\"blocks\": [1, 2]} 後",
   "expect": "前"
  },
  {
   "input": "本文です。{\"blocks\": [oops",
   "expect": "本文です。"
  },
  {
   "input": "本文です。{\"wait_for_user\": true, broken",
   "expect": "本文です。"
  },
  {
   "input": "```json\n本文 $x$ と $y\n```",
   "expect": "```json\n本文 $x$ と $y\n```"
  },
  {
   "input": "価格は $5 です",
   "expect": "価格は $5 です"
  },
  {
   "input": "集合 {a, b} を考える",
   "expect": "集合 {a, b} を考える"
  },
  {
   "input": "前 [1, 2] {\"message\": \"配列は無視\"}",
   "expect": "前 [1, 2]"
  },
  {
   "input": "{\"message\": 5, \"\": \"代替本文\"}",
   "expect": ""
  },
  {
   "input": "{\"message\":\"a\\qb\"}",
   "expect": ""
  },
  {
   "input": "{\"message\":\"never ends",
   "expect": ""
  }
 ],
